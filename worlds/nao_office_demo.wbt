}

# NAO Robot with Distance Sensors
DEF NAO_ROBOT Robot {
  translation 0 0 0.334
  rotation 0 0 1 0
  children [
    # Distance Sensor - Front
    DistanceSensor {
      translation 0.05 0 0.28
      rotation 0 0 1 0
      children [
        DEF SENSOR_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 1 0 0
            emissiveColor 1 0 0
          }
          geometry Box {
            size 0.01 0.01 0.01
          }
        }
      ]
      name "distance_front"
      lookupTable [
        0 0 0
        0.05 50 0
        1.5 1500 0
      ]
      type "sonar"
      numberOfRays 5
    }
    # Distance Sensor - Front Right
    DistanceSensor {
      translation 0.04 -0.04 0.28
      rotation 0 0 1 -0.5236
      children [
        USE SENSOR_SHAPE
      ]
      name "distance_front_right"
      lookupTable [
        0 0 0
        0.05 50 0
        1.2 1200 0
      ]
      type "sonar"
      numberOfRays 3
    }
    # Distance Sensor - Front Left
    DistanceSensor {
      translation 0.04 0.04 0.28
      rotation 0 0 1 0.5236
      children [
        USE SENSOR_SHAPE
      ]
      name "distance_front_left"
      lookupTable [
        0 0 0
        0.05 50 0
        1.2 1200 0
      ]
      type "sonar"
      numberOfRays 3
    }
    # Distance Sensor - Left
    DistanceSensor {
      translation 0 0.05 0.28
      rotation 0 0 1 1.5708
      children [
        USE SENSOR_SHAPE
      ]
      name "distance_left"
      lookupTable [
        0 0 0
        0.05 50 0
        1 1000 0
      ]
      type "sonar"
      numberOfRays 3
    }
    # Distance Sensor - Right
    DistanceSensor {
      translation 0 -0.05 0.28
      rotation 0 0 1 -1.5708
      children [
        USE SENSOR_SHAPE
      ]
      name "distance_right"
      lookupTable [
        0 0 0
        0.05 50 0
        1 1000 0
      ]
      type "sonar"
      numberOfRays 3
    }
    # Include NAO model
    Nao {
      translation 0 0 0
      rotation 0 0 1 0
      controller "<extern>"
      cameraWidth 320
      cameraHeight 240
    }
  ]
  name "NAO"
  controller "nao_office_assistant"
  supervisor TRUE
}

# Display for robot's camera view
Display {
  translation -4.8 0 1.5
  rotation 0 1 0 1.5708
  name "camera_display"
  width 320
  height 240
}

# Lighting
PointLight {
  attenuation 0 0 1
  intensity 3
  location 0 0 3.5
  castShadows TRUE
}

PointLight {
  attenuation 0 0 1
  intensity 2
  location 3 3 2.5
}

PointLight {
  attenuation 0 0 1
  intensity 2
  location -3 -3 2.5
}

PointLight {
  attenuation 0 0 1
  intensity 1.5
  location -3 3 2.5
}

PointLight {
  attenuation 0 0 1
  intensity 1.5
  location 3 -3 2.5
}
