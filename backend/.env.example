# Backend Configuration
# Copy this file to .env and fill in your values

#=============================================================================
# Azure OpenAI Configuration
#=============================================================================
# Get these values from Azure Portal > Your OpenAI Resource

# API Key (from "Keys and Endpoint" section)
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# Endpoint URL (format: https://your-resource-name.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Deployment name (from Azure OpenAI Studio > Deployments)
# Common values: gpt-4o, gpt-4-vision-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# API Version (recommended: 2024-02-15-preview)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

#=============================================================================
# Optional: Vision Service Settings
#=============================================================================
# VISION_ANALYSIS_INTERVAL=10  # Seconds between automatic analyses
# VISION_MAX_REQUESTS_PER_MINUTE=6  # Rate limit
